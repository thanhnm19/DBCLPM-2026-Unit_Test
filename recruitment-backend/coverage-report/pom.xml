<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>recruitment-backend-aggregator</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>coverage-report</artifactId>
    <packaging>pom</packaging>

    <name>Coverage Report</name>
    <description>Module tổng hợp báo cáo JaCoCo từ tất cả các backend services</description>

    <dependencies>
        <dependency><groupId>com.example</groupId><artifactId>gateway</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>com.example</groupId><artifactId>candidate-service</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>com.example</groupId><artifactId>communications-service</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>com.example</groupId><artifactId>job-service</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>com.example</groupId><artifactId>notification-service</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>com.example</groupId><artifactId>schedule-service</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>com.example</groupId><artifactId>statistics-service</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>com.example</groupId><artifactId>upload-service</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>com.example</groupId><artifactId>user-service</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>com.example</groupId><artifactId>workflow-service</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
                            <includes>
                                <!-- Job-service -->
                                <include>com/example/job_service/service/JobPositionService*</include>
                                <include>com/example/job_service/service/OfferService*</include>
                                <include>com/example/job_service/service/RecruitmentRequestService*</include>

                                <!-- Candidate-service -->
                                <include>com/example/candidate_service/service/UserService*</include>
                                <include>com/example/candidate_service/service/JobService*</include>
                                <include>com/example/candidate_service/service/CandidateService*</include>
                                <include>com/example/candidate_service/service/ScheduleService*</include>
                                <include>com/example/candidate_service/service/ReviewCandidateService*</include>
                                <include>com/example/candidate_service/service/CommentService*</include>
                                <include>com/example/candidate_service/service/CloudinaryService*</include>

                                <!-- User-service -->
                                <include>com/example/user_service/service/UserService*</include>
                                <include>com/example/user_service/service/EmployeeService*</include>
                                <include>com/example/user_service/service/DepartmentService*</include>
                                <include>com/example/user_service/service/PositionService*</include>
                                <include>com/example/user_service/service/RoleService*</include>
                                <include>com/example/user_service/service/PermissionService*</include>
                                <include>com/example/user_service/service/UserDetailCustom*</include>
                                <include>com/example/user_service/config/PermissionInterceptor*</include>
                                <include>com/example/user_service/utils/JwtUtil*</include>

                                <!-- Workflow-service -->
                                <include>com/example/workflow_service/service/WorkflowService*</include>
                                <include>com/example/workflow_service/service/ApprovalTrackingService*</include>

                                <!-- Other Services -->
                                <include>com/example/notification_service/service/NotificationService*</include>
                                <include>com/example/schedule_service/service/ScheduleService*</include>
                                <include>com/example/schedule_service/service/ScheduleStatusUpdateService*</include>
                                <include>com/example/statistics_service/service/StatisticsService*</include>
                                <include>com/example/upload_service/service/CloudinaryService*</include>
                            </includes>
                            <excludes>
                                <!-- Loại bỏ class Application và các class ẩn/nội phát sinh -->
                                <exclude>**/*Application.*</exclude>
                                <exclude>**/*$*.class</exclude>
                                
                                <!-- Loại bỏ các Client gọi Microservice (vì đã được Mock) -->
                                <exclude>com/example/job_service/service/*Client*</exclude>
                                <exclude>com/example/notification_service/service/SocketIOBroadcastService*</exclude>
                                <exclude>com/example/statistics_service/service/client/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
