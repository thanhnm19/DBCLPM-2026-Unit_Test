{
  "info": {
    "name": "Recruitment System API Tests - ApprovalTracking ",
    "_postman_id": "recruit-api-AT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "workflowId", "value": "" },
    { "key": "trackingId", "value": "" },
    { "key": "rrId", "value": "" },
    { "key": "pendingRrId", "value": "" }
  ],
  "item": [
    {
      "name": "ApprovalTracking",
      "item": [
        {
          "name": "AT-TC01 - Initialize approval tracking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC01] Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC01] Co id', () => pm.expect(body.data.id).to.be.a('number'));",
                  "pm.test('[AT-TC01] Status PENDING', () => pm.expect(body.data.status).to.equal('PENDING'));",
                  "pm.collectionVariables.set('trackingId', body.data.id);",
                  "console.log('[DB CHECK] SELECT * FROM approval_trackings WHERE id=' + body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/initialize",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"requestId\": {{rrId}}, \"requestType\": \"RECRUITMENT_REQUEST\", \"workflowId\": {{workflowId}}}"
            }
          }
        },
        {
          "name": "AT-TC02 - Get all trackings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC02] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC02] Co meta va result', () => {",
                  "  pm.expect(body.data.meta).to.exist;",
                  "  pm.expect(body.data.result).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC03 - Filter theo requestId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC03] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const rrId = parseInt(pm.collectionVariables.get('rrId'));",
                  "pm.test('[AT-TC03] Tat ca co requestId dung', () => {",
                  "  body.data.result.forEach(t => pm.expect(t.requestId).to.equal(rrId));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/workflow-service/approval-trackings?requestId={{rrId}}",
              "query": [{ "key": "requestId", "value": "{{rrId}}" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC04 - Filter theo status=PENDING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC04] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC04] Tat ca status PENDING', () => {",
                  "  body.data.result.forEach(t => pm.expect(t.status).to.equal('PENDING'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/workflow-service/approval-trackings?status=PENDING",
              "query": [{ "key": "status", "value": "PENDING" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC05 - Get tracking by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC05] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC05] ID dung', () => pm.expect(body.data.id).to.equal(parseInt(pm.collectionVariables.get('trackingId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/{{trackingId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC06 - Get pending approvals cho user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC06] Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('[AT-TC06] Result la array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/pending/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC07 - Approve mot buoc",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC07] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC07] Status la APPROVED hoac PENDING', () => {",
                  "  pm.expect(body.data.status).to.be.oneOf(['APPROVED', 'PENDING']);",
                  "});",
                  "console.log('[DB CHECK] SELECT status FROM approval_trackings WHERE id=' + pm.collectionVariables.get('trackingId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/{{trackingId}}/approve",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"APPROVED\", \"notes\": \"Dong y\"}"
            }
          }
        },
        {
          "name": "AT-TC08 - Reject mot buoc",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC08] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC08] Status REJECTED', () => pm.expect(body.data.status).to.equal('REJECTED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/{{trackingId}}/approve",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"REJECTED\", \"notes\": \"Khong du dieu kien\"}"
            }
          }
        },
        {
          "name": "AT-TC09 - Get workflow info by requestId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC09] Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('[AT-TC09] Co du lieu response', () => pm.expect(pm.response.json().data).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/workflow-service/approval-trackings/by-request/{{rrId}}?requestType=RECRUITMENT_REQUEST",
              "query": [{ "key": "requestType", "value": "RECRUITMENT_REQUEST" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    }
  ]
}
