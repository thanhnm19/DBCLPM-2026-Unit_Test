        {
          "name": "RR-TC01 - Tao yeu cau tuyen dung",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC01] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[RR-TC01] Co id', () => pm.expect(body.data.id).to.be.a('number'));",
                  "pm.test('[RR-TC01] Status DRAFT', () => pm.expect(body.data.status).to.equal('DRAFT'));",
                  "pm.test('[RR-TC01] isActive = true', () => pm.expect(body.data.active).to.be.true);",
                  "pm.collectionVariables.set('rrId', body.data.id);",
                  "console.log('[DB CHECK] SELECT status, is_active FROM recruitment_requests WHERE id=' + body.data.id);",
                  "console.log('[ROLLBACK] DELETE FROM recruitment_requests WHERE id=' + body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/recruitment-requests",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Tuyen Java Dev\", \"quantity\": 2, \"reason\": \"Mo rong team\", \"salaryMin\": 10000000, \"salaryMax\": 20000000, \"workflowId\": {{workflowId}}, \"departmentId\": 5}"
