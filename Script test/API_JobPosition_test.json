{
  "info": {
    "name": "Recruitment System API Tests - JobPosition ",
    "_postman_id": "recruit-api-jp",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "rrId", "value": "" },
    { "key": "jpId", "value": "" },
    { "key": "offerId", "value": "" },
    { "key": "workflowId", "value": "" }
  ],
  "item": [
    {
      "name": "JobPosition",
      "item": [
        {
          "name": "JP-TC01 - Tao vi tri tuyen dung",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC01] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC01] Co id', () => pm.expect(body.data.id).to.be.a('number'));",
                  "pm.collectionVariables.set('jpId', body.data.id);",
                  "console.log('[DB CHECK] SELECT * FROM job_positions WHERE id=' + body.data.id);",
                  "console.log('[ROLLBACK] DELETE FROM job_positions WHERE id=' + body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/job-positions",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Java Developer\", \"recruitmentRequestId\": {{rrId}}, \"departmentId\": 5, \"description\": \"Mo ta vi tri\"}"
            }
          }
        },
        {
          "name": "JP-TC02 - Get by ID (co department name)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC02] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC02] Co id', () => pm.expect(body.data.id).to.be.a('number'));",
                  "pm.test('[JP-TC02] Co departmentName', () => pm.expect(body.data.departmentName).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/job-positions/{{jpId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "JP-TC03 - Get simple by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC03] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC03] Co id va title', () => {",
                  "  pm.expect(body.data.id).to.be.a('number');",
                  "  pm.expect(body.data.title).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/job-positions/simple/{{jpId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "JP-TC04 - Get list phan trang",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC04] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC04] Co meta va result', () => {",
                  "  pm.expect(body.data.meta).to.exist;",
                  "  pm.expect(body.data.result).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/job-service/job-positions?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "JP-TC05 - Filter theo status=OPEN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC05] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC05] Tat ca status OPEN', () => {",
                  "  body.data.result.forEach(j => pm.expect(j.status).to.equal('OPEN'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/job-service/job-positions?status=OPEN",
              "query": [{ "key": "status", "value": "OPEN" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "JP-TC07 - Get published list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC07] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC07] Tat ca status PUBLISHED', () => {",
                  "  body.data.result.forEach(j => pm.expect(j.status).to.equal('PUBLISHED'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/job-positions/published",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "JP-TC10 - Update vi tri",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC10] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC10] Title da cap nhat', () => pm.expect(body.data.title).to.equal('Senior Java Dev'));",
                  "console.log('[DB CHECK] SELECT title FROM job_positions WHERE id=' + pm.collectionVariables.get('jpId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/v1/job-service/job-positions/{{jpId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Senior Java Dev\", \"description\": \"Updated description\"}"
            }
          }
        },
        {
          "name": "JP-TC11 - Publish vi tri",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC11] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC11] Status PUBLISHED', () => pm.expect(body.data.status).to.equal('PUBLISHED'));",
                  "console.log('[DB CHECK] SELECT status, published FROM job_positions WHERE id=' + pm.collectionVariables.get('jpId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/job-positions/{{jpId}}/publish",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "JP-TC12 - Close vi tri",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC12] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC12] Status CLOSED', () => pm.expect(body.data.status).to.equal('CLOSED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/job-positions/{{jpId}}/close",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "JP-TC13 - Reopen vi tri",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC13] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[JP-TC13] Status OPEN', () => pm.expect(body.data.status).to.equal('OPEN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/job-positions/{{jpId}}/reopen",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "JP-TC14 - Delete vi tri",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[JP-TC14] Status 204', () => pm.response.to.have.status(204));",
                  "console.log('[DB CHECK] SELECT * FROM job_positions WHERE id=' + pm.collectionVariables.get('jpId') + ' -- verify deleted/deactivated');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/job-service/job-positions/{{jpId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    }
  ]
}
