{
  "info": {
    "name": "Recruitment System API Tests -Offer",
    "_postman_id": "recruit-api-OF",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "rrId", "value": "" },
    { "key": "jpId", "value": "" },
    { "key": "offerId", "value": "" },
    { "key": "workflowId", "value": "" }
  ],
  "item": [
    {
      "name": "Offer",
      "item": [
        {
          "name": "OF-TC01 - Tao offer luong",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC01] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC01] Co id', () => pm.expect(body.data.id).to.be.a('number'));",
                  "pm.test('[OF-TC01] Status DRAFT', () => pm.expect(body.data.status).to.equal('DRAFT'));",
                  "pm.collectionVariables.set('offerId', body.data.id);",
                  "console.log('[DB CHECK] SELECT status FROM offers WHERE id=' + body.data.id);",
                  "console.log('[ROLLBACK] DELETE FROM offers WHERE id=' + body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"candidateId\": 1, \"jobPositionId\": {{jpId}}, \"salaryOffered\": 15000000, \"onboardingDate\": \"2025-06-01\", \"workflowId\": {{workflowId}}}"
            }
          }
        },
        {
          "name": "OF-TC02 - Tao offer thieu truong bat buoc",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC02] Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"salaryOffered\": 15000000}"
            }
          }
        },
        {
          "name": "OF-TC03 - Submit offer DRAFT to PENDING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC03] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC03] Status PENDING', () => pm.expect(body.data.status).to.equal('PENDING'));",
                  "console.log('[DB CHECK] SELECT status FROM offers WHERE id=' + pm.collectionVariables.get('offerId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/submit/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC04 - Submit offer da PENDING - phai loi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC04] Status 400 hoac 500', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 500]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/submit/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC05 - Approve buoc offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC05] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC05] Status PENDING (workflow async)', () => pm.expect(body.data.status).to.equal('PENDING'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/approve/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"approvalNotes\": \"Chap thuan muc luong\"}"
            }
          }
        },
        {
          "name": "OF-TC06 - Reject offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC06] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC06] Status REJECTED', () => pm.expect(body.data.status).to.equal('REJECTED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/reject/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"reason\": \"Muc luong qua cao\"}"
            }
          }
        },
        {
          "name": "OF-TC07 - Return offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC07] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC07] Status RETURNED', () => pm.expect(body.data.status).to.equal('RETURNED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/return/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"reason\": \"Dieu chinh lai ngay onboarding\"}"
            }
          }
        },
        {
          "name": "OF-TC08 - Cancel offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC08] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC08] Status CANCELLED', () => pm.expect(body.data.status).to.equal('CANCELLED'));",
                  "console.log('[DB CHECK] SELECT status FROM offers WHERE id=' + pm.collectionVariables.get('offerId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/cancel/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"reason\": \"Ung vien tu choi\"}"
            }
          }
        },
        {
          "name": "OF-TC09 - Withdraw offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC09] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC09] Status WITHDRAWN', () => pm.expect(body.data.status).to.equal('WITHDRAWN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/withdraw/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"reason\": \"Thay doi quyet dinh\"}"
            }
          }
        },
        {
          "name": "OF-TC10 - Get offer by ID (chi tiet)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC10] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC10] Co id', () => pm.expect(body.data.id).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/offers/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC11 - Get all offers phan trang",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC11] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC11] Co meta va result', () => {",
                  "  pm.expect(body.data.meta).to.exist;",
                  "  pm.expect(body.data.result).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/job-service/offers?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC12 - Filter theo status=PENDING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC12] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC12] Tat ca status PENDING', () => {",
                  "  body.data.result.forEach(o => pm.expect(o.status).to.equal('PENDING'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/job-service/offers?status=PENDING",
              "query": [{ "key": "status", "value": "PENDING" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC13 - Update offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC13] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC13] salaryOffered da cap nhat', () => pm.expect(body.data.salaryOffered).to.equal(16000000));",
                  "console.log('[DB CHECK] SELECT salary_offered FROM offers WHERE id=' + pm.collectionVariables.get('offerId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/v1/job-service/offers/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"salaryOffered\": 16000000}"
            }
          }
        },
        {
          "name": "OF-TC14 - Soft delete offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC14] Status 204', () => pm.response.to.have.status(204));",
                  "console.log('[DB CHECK] SELECT is_active FROM offers WHERE id=' + pm.collectionVariables.get('offerId') + ' -- phai la false');",
                  "console.log('[DB CHECK] Record van con trong DB (soft delete).');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/job-service/offers/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    }
  ]
}
