{
  "info": {
    "name": "Recruitment System API Tests - Offer",
    "_postman_id": "recruit-api-OF",
    "description": "Luồng CRUD tự rollback: GET baseline → POST tạo → GET verify → PUT sửa → GET verify → POST submit → GET verify → DELETE → GET verify xóa.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "rrId", "value": "" },
    { "key": "jpId", "value": "" },
    { "key": "offerId", "value": "" },
    { "key": "workflowId", "value": "" },
    { "key": "initialTotalOffer", "value": "0" }
  ],
  "item": [
    {
      "name": "Offer CRUD Lifecycle (tự rollback)",
      "item": [
        {
          "name": "STEP 0 - Login lay token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[STEP-0] Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "http://localhost:8081/api/v1/user-service/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin@gmail.com\", \"password\": \"123456\"}"
            }
          }
        },
        {
          "name": "OF-TC01 - GET BASELINE: Dem tong offer ban dau",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC01] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const total = body.data.meta.total || body.data.result.length;",
                  "pm.collectionVariables.set('initialTotalOffer', total);",
                  "console.log('[BASELINE] Tong offer ban dau: ' + total);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/job-service/offers?page=1&limit=100",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "100" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC02 - POST: Tao offer moi (DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC02] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC02] Co id', () => pm.expect(body.data.id).to.be.a('number'));",
                  "pm.test('[OF-TC02] Status DRAFT', () => pm.expect(body.data.status).to.equal('DRAFT'));",
                  "pm.collectionVariables.set('offerId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"candidateId\": 1, \"jobPositionId\": {{jpId}}, \"salaryOffered\": 15000000, \"onboardingDate\": \"2025-06-01\", \"workflowId\": {{workflowId}}}"
            }
          }
        },
        {
          "name": "OF-TC03 - GET VERIFY TAO: Lay offer vua tao bang ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC03] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const expectedId = parseInt(pm.collectionVariables.get('offerId'));",
                  "pm.test('[OF-TC03] ID dung', () => pm.expect(body.data.id).to.equal(expectedId));",
                  "pm.test('[OF-TC03] Status DRAFT trong DB', () => pm.expect(body.data.status).to.equal('DRAFT'));",
                  "pm.test('[OF-TC03] salaryOffered dung', () => pm.expect(body.data.salaryOffered).to.equal(15000000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/offers/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC04 - PUT: Cap nhat salary offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC04] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC04] salaryOffered da cap nhat', () => pm.expect(body.data.salaryOffered).to.equal(16000000));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/v1/job-service/offers/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"salaryOffered\": 16000000}"
            }
          }
        },
        {
          "name": "OF-TC05 - GET VERIFY SUA: Kiem tra salary da doi trong DB",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC05] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC05] salaryOffered = 16000000 trong DB', () => pm.expect(body.data.salaryOffered).to.equal(16000000));",
                  "pm.test('[OF-TC05] Status van la DRAFT', () => pm.expect(body.data.status).to.equal('DRAFT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/offers/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC06 - POST: Submit offer DRAFT -> PENDING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC06] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC06] Status PENDING', () => pm.expect(body.data.status).to.equal('PENDING'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/submit/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC07 - GET VERIFY: Status = PENDING trong DB",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC07] Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('[OF-TC07] Status PENDING trong DB', () => pm.expect(pm.response.json().data.status).to.equal('PENDING'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/offers/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC08 - POST: Submit da PENDING lan nua (phai loi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC08] Status 400 hoac 500', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 500]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/submit/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC09 - DELETE (ROLLBACK): Soft delete offer vua tao",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC09] Status 200 hoac 204', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/job-service/offers/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC10 - GET VERIFY XOA: Offer da bi xoa/inactive",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.test('[OF-TC10] Soft deleted: isActive = false', () => {",
                  "    pm.expect(pm.response.json().data.active).to.be.false;",
                  "  });",
                  "} else {",
                  "  pm.test('[OF-TC10] Deleted: Status 400 hoac 404', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 404]);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/offers/{{offerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Offer Negative Cases (khong can rollback)",
      "item": [
        {
          "name": "OF-TC11 - POST: Tao offer thieu truong bat buoc (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC11] Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"salaryOffered\": 15000000}"
            }
          }
        },
        {
          "name": "OF-TC12 - POST: Return offer (BUG Backend - khong ho tro, phai 400)",
          "description": "⚠️ Backend: OfferService.java throw IllegalStateException('Workflow offer không hỗ trợ trả về (return) nữa'). API này LUÔN trả 400/500.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC12] Status 400 hoac 500 - Backend khong ho tro return', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 500]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/return/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"reason\": \"Dieu chinh lai ngay onboarding\"}"
            }
          }
        },
        {
          "name": "OF-TC13 - GET: List phan trang",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC13] Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('[OF-TC13] Co meta va result', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.meta).to.exist;",
                  "  pm.expect(body.data.result).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/job-service/offers?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC14 - GET: Filter status=PENDING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC14] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[OF-TC14] Tat ca status PENDING', () => {",
                  "  body.data.result.forEach(o => pm.expect(o.status).to.equal('PENDING'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/job-service/offers?status=PENDING",
              "query": [{ "key": "status", "value": "PENDING" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "OF-TC15 - POST: Tao offer voi onboardingDate trong qua khu",
          "description": "Validation lỗi thời gian.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC15] Status 400 - Validation loi thoi gian', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"candidateId\": 1, \"jobPositionId\": {{jpId}}, \"salaryOffered\": 15000000, \"onboardingDate\": \"2020-01-01\", \"workflowId\": {{workflowId}}}"
            }
          }
        },
        {
          "name": "OF-TC16 - POST: Tao offer voi basicSalary > salaryMax cua Job",
          "description": "Kiểm tra lỗi over budget.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC16] Status 400 - Vuot ngan sach', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"candidateId\": 1, \"jobPositionId\": {{jpId}}, \"salaryOffered\": 999999999, \"onboardingDate\": \"2025-06-01\", \"workflowId\": {{workflowId}}}"
            }
          }
        },
        {
          "name": "OF-TC17 - POST: Tao offer voi probationPeriod < 0 hoac probationSalaryRate > 100",
          "description": "Kiểm tra giá trị biên thử việc.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC17] Status 400 - Validation loi probation', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"candidateId\": 1, \"jobPositionId\": {{jpId}}, \"salaryOffered\": 15000000, \"onboardingDate\": \"2025-06-01\", \"workflowId\": {{workflowId}}, \"probationPeriod\": -1, \"probationSalaryRate\": 150}"
            }
          }
        }
      ]
    },
    {
      "name": "Offer State Endpoints",
      "description": "Test các API Approve và Reject Offer",
      "item": [
        {
          "name": "OF-TC18 - POST: Approve Offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC18] Status 200 hoac 400', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/approve/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"notes\": \"Duyet offer\"}"
            }
          }
        },
        {
          "name": "OF-TC19 - POST: Reject Offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[OF-TC19] Status 200 hoac 400', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/offers/reject/{{offerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"reason\": \"Khong duyet offer vi luong qua cao\"}"
            }
          }
        }
      ]
    }
  ]
}
