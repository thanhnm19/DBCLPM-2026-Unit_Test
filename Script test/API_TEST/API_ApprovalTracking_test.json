{
  "info": {
    "name": "Recruitment System API Tests - ApprovalTracking",
    "_postman_id": "recruit-api-AT",
    "description": "Luồng CRUD tự rollback: GET baseline → POST initialize → GET verify → POST approve → GET verify → (rollback by reject/clean).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "workflowId", "value": "" },
    { "key": "trackingId", "value": "" },
    { "key": "rrId", "value": "" },
    { "key": "initialTotalTracking", "value": "0" }
  ],
  "item": [
    {
      "name": "ApprovalTracking CRUD Lifecycle (tự rollback)",
      "item": [
        {
          "name": "STEP 0 - Login lay token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[STEP-0] Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "http://localhost:8081/api/v1/user-service/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin@gmail.com\", \"password\": \"123456\"}"
            }
          }
        },
        {
          "name": "AT-TC01 - GET BASELINE: Dem tong tracking ban dau",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC01] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC01] Co meta va result', () => {",
                  "  pm.expect(body.data.meta).to.exist;",
                  "  pm.expect(body.data.result).to.be.an('array');",
                  "});",
                  "const total = body.data.meta.total || body.data.result.length;",
                  "pm.collectionVariables.set('initialTotalTracking', total);",
                  "console.log('[BASELINE] Tong tracking ban dau: ' + total);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC02 - POST: Initialize approval tracking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC02] Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC02] Co id', () => pm.expect(body.data.id).to.be.a('number'));",
                  "pm.test('[AT-TC02] Status PENDING', () => pm.expect(body.data.status).to.equal('PENDING'));",
                  "pm.collectionVariables.set('trackingId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/initialize",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"requestId\": {{rrId}}, \"requestType\": \"RECRUITMENT_REQUEST\", \"workflowId\": {{workflowId}}}"
            }
          }
        },
        {
          "name": "AT-TC03 - GET VERIFY TAO: Lay tracking vua tao bang ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC03] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const expectedId = parseInt(pm.collectionVariables.get('trackingId'));",
                  "pm.test('[AT-TC03] ID dung', () => pm.expect(body.data.id).to.equal(expectedId));",
                  "pm.test('[AT-TC03] Status PENDING trong DB', () => pm.expect(body.data.status).to.equal('PENDING'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/{{trackingId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC04 - GET VERIFY TAO: List tracking phai tang so luong",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC04] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const initialTotal = parseInt(pm.collectionVariables.get('initialTotalTracking'));",
                  "const currentTotal = body.data.meta.total || body.data.result.length;",
                  "pm.test('[AT-TC04] Tong tracking tang it nhat 1 (' + initialTotal + ' -> ' + currentTotal + ')', () => {",
                  "  pm.expect(currentTotal).to.be.greaterThan(initialTotal);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC05 - POST: Approve buoc dau tien",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC05] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC05] Status APPROVED hoac PENDING (next step)', () => {",
                  "  pm.expect(body.data.status).to.be.oneOf(['APPROVED', 'PENDING']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/{{trackingId}}/approve",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"APPROVED\", \"notes\": \"Dong y\"}"
            }
          }
        },
        {
          "name": "AT-TC06 - GET VERIFY: Status da thay doi sau approve",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC06] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC06] Status da doi (APPROVED hoac PENDING)', () => {",
                  "  pm.expect(body.data.status).to.be.oneOf(['APPROVED', 'PENDING']);",
                  "});",
                  "pm.test('[AT-TC06] ID khong doi', () => {",
                  "  pm.expect(body.data.id).to.equal(parseInt(pm.collectionVariables.get('trackingId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/{{trackingId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "ApprovalTracking Read & Filter (khong tao du lieu)",
      "item": [
        {
          "name": "AT-TC07 - GET: Filter theo requestId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC07] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const rrId = parseInt(pm.collectionVariables.get('rrId'));",
                  "pm.test('[AT-TC07] Tat ca co requestId dung', () => {",
                  "  body.data.result.forEach(t => pm.expect(t.requestId).to.equal(rrId));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/workflow-service/approval-trackings?requestId={{rrId}}",
              "query": [{ "key": "requestId", "value": "{{rrId}}" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC08 - GET: Filter theo status=PENDING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC08] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC08] Tat ca status PENDING', () => {",
                  "  body.data.result.forEach(t => pm.expect(t.status).to.equal('PENDING'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/workflow-service/approval-trackings?status=PENDING",
              "query": [{ "key": "status", "value": "PENDING" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC09 - GET: Pending approvals cho user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC09] Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('[AT-TC09] Result la array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/pending/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "AT-TC10 - GET: Workflow info by requestId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC10] Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('[AT-TC10] Co du lieu response', () => pm.expect(pm.response.json().data).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/workflow-service/approval-trackings/by-request/{{rrId}}?requestType=RECRUITMENT_REQUEST",
              "query": [{ "key": "requestType", "value": "RECRUITMENT_REQUEST" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "ApprovalTracking Negative & Edge Cases",
      "item": [
        {
          "name": "AT-TC11 - POST: Approve voi action REJECTED",
          "description": "Cố tình từ chối tracking. Prerequisite: Cần 1 trackingId đang ở trạng thái PENDING.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC11] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC11] Status la REJECTED', () => pm.expect(body.data.status).to.equal('REJECTED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/{{trackingId}}/approve",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"REJECTED\", \"notes\": \"Khong duyet\"}"
            }
          }
        },
        {
          "name": "AT-TC12 - POST: Approve voi action RETURNED",
          "description": "Cố tình trả về tracking. Prerequisite: Cần 1 trackingId đang ở trạng thái PENDING.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC12] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[AT-TC12] Status la RETURNED', () => pm.expect(body.data.status).to.equal('RETURNED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/{{trackingId}}/approve",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"RETURNED\", \"notes\": \"Tra ve yeu cau sua lai\"}"
            }
          }
        },
        {
          "name": "AT-TC13 - POST: User A approve cho tracking cua User B (Phai bi chan)",
          "description": "Dùng Token của một User không có quyền để cố tình duyệt (action: APPROVED).",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[AT-TC13] Status 403 - Forbidden do sai quyen nguoi duyet', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([403, 400]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/workflow-service/approval-trackings/{{trackingId}}/approve",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employee_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"APPROVED\", \"notes\": \"Duyet trum\"}"
            }
          }
        }
      ]
    }
  ]
}
