    { "key": "draftRrId", "value": "" },
    { "key": "rejectedRrId", "value": "" },
    { "key": "jpId", "value": "" },
    { "key": "publishedJpId", "value": "" },
    { "key": "closedJpId", "value": "" },
    { "key": "workflowId", "value": "" },
    { "key": "initialTotalJP", "value": "0" }
