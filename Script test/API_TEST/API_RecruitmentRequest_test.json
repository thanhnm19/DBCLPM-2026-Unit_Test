{
  "info": {
    "name": "Recruitment System API Tests - RecruitmentRequest",
    "_postman_id": "recruit-api-RR",
    "description": "Luồng CRUD tự rollback: GET baseline → POST tạo → GET verify → PUT sửa → GET verify sửa → DELETE → GET verify xóa. Dữ liệu test tự dọn sạch.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "workflowId", "value": "" },
    { "key": "trackingId", "value": "" },
    { "key": "rrId", "value": "" },
    { "key": "pendingRrId", "value": "" },
    { "key": "approvedRrId", "value": "" },
    { "key": "initialTotalRR", "value": "0" }
  ],
  "item": [
    {
      "name": "RecruitmentRequest CRUD Lifecycle (tự rollback)",
      "item": [
        {
          "name": "STEP 0 - Login lay token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[STEP-0] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "http://localhost:8081/api/v1/user-service/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin@gmail.com\", \"password\": \"123456\"}"
            }
          }
        },
        {
          "name": "RR-TC01 - GET BASELINE: Dem tong yeu cau tuyen dung ban dau",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC01] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[RR-TC01] Co result array', () => pm.expect(body.data.result).to.be.an('array'));",
                  "const total = body.data.meta.total || body.data.result.length;",
                  "pm.collectionVariables.set('initialTotalRR', total);",
                  "console.log('[BASELINE] Tong RR ban dau: ' + total);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/job-service/recruitment-requests?page=1&limit=100",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "100" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "RR-TC02 - POST: Tao yeu cau tuyen dung moi (DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC02] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[RR-TC02] Co id', () => pm.expect(body.data.id).to.be.a('number'));",
                  "pm.test('[RR-TC02] Status DRAFT', () => pm.expect(body.data.status).to.equal('DRAFT'));",
                  "pm.test('[RR-TC02] isActive = true', () => pm.expect(body.data.active).to.be.true);",
                  "pm.collectionVariables.set('rrId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/recruitment-requests",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Tuyen Java Dev\", \"quantity\": 2, \"reason\": \"Mo rong team\", \"salaryMin\": 10000000, \"salaryMax\": 20000000, \"workflowId\": {{workflowId}}, \"departmentId\": 5}"
            }
          }
        },
        {
          "name": "RR-TC03 - GET VERIFY TAO: Lay RR vua tao bang ID",
          "description": "Verify record vừa insert vào DB bằng GET by ID.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC03] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const expectedId = parseInt(pm.collectionVariables.get('rrId'));",
                  "pm.test('[RR-TC03] ID dung', () => pm.expect(body.data.id).to.equal(expectedId));",
                  "pm.test('[RR-TC03] Title dung', () => pm.expect(body.data.title).to.equal('Tuyen Java Dev'));",
                  "pm.test('[RR-TC03] Status DRAFT trong DB', () => pm.expect(body.data.status).to.equal('DRAFT'));",
                  "pm.test('[RR-TC03] quantity = 2', () => pm.expect(body.data.quantity).to.equal(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/recruitment-requests/{{rrId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "RR-TC04 - PUT: Cap nhat yeu cau tuyen dung (DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC04] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[RR-TC04] Title da cap nhat', () => pm.expect(body.data.title).to.equal('Updated Java Dev'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/v1/job-service/recruitment-requests/{{rrId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Updated Java Dev\", \"quantity\": 3, \"reason\": \"Sua de test\", \"salaryMin\": 10000000, \"salaryMax\": 20000000}"
            }
          }
        },
        {
          "name": "RR-TC05 - GET VERIFY SUA: Kiem tra title da doi trong DB",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC05] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[RR-TC05] Title da thay doi thanh cong trong DB', () => pm.expect(body.data.title).to.equal('Updated Java Dev'));",
                  "pm.test('[RR-TC05] Quantity da thay doi', () => pm.expect(body.data.quantity).to.equal(3));",
                  "pm.test('[RR-TC05] Status van la DRAFT', () => pm.expect(body.data.status).to.equal('DRAFT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/recruitment-requests/{{rrId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "RR-TC06 - DELETE (ROLLBACK): Soft delete yeu cau vua tao",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC06] Status 200 hoac 204', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/job-service/recruitment-requests/{{rrId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "RR-TC07 - GET VERIFY XOA: RR da bi xoa/inactive, GET phai tra 400/404 hoac isActive=false",
          "description": "Verify soft delete: GET by ID phải trả về 400/404 hoặc record có isActive=false.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Soft delete: có thể vẫn GET được nhưng isActive=false, hoặc trả 400/404",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('[RR-TC07] Soft deleted: isActive = false', () => {",
                  "    pm.expect(body.data.active).to.be.false;",
                  "  });",
                  "} else {",
                  "  pm.test('[RR-TC07] Hard deleted: Status 400 hoac 404', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 404]);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/job-service/recruitment-requests/{{rrId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
