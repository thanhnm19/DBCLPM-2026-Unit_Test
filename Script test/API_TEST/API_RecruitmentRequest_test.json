    {
      "name": "RecruitmentRequest Auto-Approve Logic (tạo + submit + verify + rollback)",
      "description": "Kiểm tra logic Auto-Approve: actorId trùng approverPositionId Bước 1 → hệ thống tự duyệt Bước 1 → sinh Tracking PENDING cho Bước 2.",
      "item": [
        {
          "name": "RR-TC21 - POST: Tao phieu de test Auto-Approve",
          "description": "Tạo phiếu mới dùng workflow có step 1 approverPositionId trùng với positionId của user đang login.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC21] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('rrId', body.data.id);",
                  "pm.test('[RR-TC21] Status DRAFT', () => pm.expect(body.data.status).to.equal('DRAFT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/recruitment-requests",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"RR Auto-Approve Test\", \"quantity\": 1, \"reason\": \"Test auto-approve\", \"salaryMin\": 10000000, \"salaryMax\": 20000000, \"workflowId\": {{workflowId}}, \"departmentId\": 5}"
            }
          }
        },
        {
          "name": "RR-TC22 - POST: Submit → Auto-Approve Buoc 1 (actorId = approverPositionId Buoc 1)",
          "description": "Prerequisite: access_token là của user có positionId = approverPositionId ở Bước 1 của workflow. Sau submit, Bước 1 phải tự APPROVED, phiếu vẫn PENDING (chờ Bước 2).",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC22] Status 200 - Submit thanh cong', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[RR-TC22] Status phieu PENDING (cho Buoc 2)', () => pm.expect(body.data.status).to.equal('PENDING'));",
                  "pm.test('[RR-TC22] submittedAt khong null', () => pm.expect(body.data.submittedAt).to.not.be.null);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/job-service/recruitment-requests/submit/{{rrId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "RR-TC23 - GET VERIFY: Buoc 1 da tu dong APPROVED, Buoc 2 dang PENDING",
          "description": "Gọi GET approval-trackings by requestId để verify: step_order=1 phải APPROVED, step_order=2 phải PENDING.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC23] Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "// Response có thể là mảng hoặc object tùy API design",
                  "const data = Array.isArray(body.data) ? body.data : (body.data.result || [body.data]);",
                  "pm.test('[RR-TC23] Co it nhat 1 tracking', () => pm.expect(data.length).to.be.greaterThan(0));",
                  "// Tìm tracking step 1 và step 2",
                  "const step1 = data.find(t => t.stepOrder === 1 || t.currentStep === 1);",
                  "const step2 = data.find(t => t.stepOrder === 2 || t.currentStep === 2);",
                  "if (step1) {",
                  "  pm.test('[RR-TC23] Buoc 1: Auto-APPROVED', () => pm.expect(step1.status).to.equal('APPROVED'));",
                  "}",
                  "if (step2) {",
                  "  pm.test('[RR-TC23] Buoc 2: PENDING (cho nguoi duyet tiep)', () => pm.expect(step2.status).to.equal('PENDING'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/workflow-service/approval-trackings/by-request/{{rrId}}?requestType=RECRUITMENT_REQUEST",
              "query": [{ "key": "requestType", "value": "RECRUITMENT_REQUEST" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "RR-TC24 - DELETE (ROLLBACK): Xoa phieu auto-approve test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RR-TC24] Status 200 hoac 204', () => {",
